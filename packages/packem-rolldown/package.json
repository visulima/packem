{
    "name": "@visulima/packem-rolldown",
    "version": "0.0.0",
    "description": "Rolldown plugins for packem",
    "keywords": [
        "visulima",
        "packem-rolldown"
    ],
    "homepage": "https://github.com/visulima/packem/tree/main/packages/packem-rolldown",
    "bugs": {
        "url": "https://github.com/visulima/packem/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/visulima/packem.git",
        "directory": "packages/packem-rolldown"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/prisis"
        },
        {
            "type": "consulting",
            "url": "https://anolilab.com/support"
        }
    ],
    "license": "MIT",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "browser": "./dist/index.mjs",
    "types": "dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "packem build --development",
        "build:prod": "packem build --production",
        "clean": "rimraf node_modules dist .eslintcache",
        "dev": "pnpm run build --watch",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:package-json": "publint --strict",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui --coverage.enabled=true",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@anolilab/eslint-config": "^27.0.2",
        "@anolilab/semantic-release-pnpm": "8.1.9",
        "@anolilab/semantic-release-preset": "^13.4.10",
        "@secretlint/secretlint-rule-preset-recommend": "^13.0.0",
        "@total-typescript/ts-reset": "^0.6.1",
        "@types/node": "25.6.2",
        "@visulima/packem": "^1.28.3",
        "@vitest/coverage-v8": "^4.1.5",
        "@vitest/ui": "^4.1.5",
        "conventional-changelog-conventionalcommits": "9.3.1",
        "esbuild": "^0.28.0",
        "eslint": "^10.3.0",
        "rimraf": "^6.1.3",
        "secretlint": "13.0.0",
        "semantic-release": "^25.0.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    },
    "engines": {
        "node": ">=20.* <=24.*"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}

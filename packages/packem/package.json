    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./config": {
            "types": "./dist/config/index.d.ts",
            "default": "./dist/config/index.js"
        },
        "./config/preset/react": {
            "types": "./dist/config/preset/react.d.ts",
            "default": "./dist/config/preset/react.js"
        },
        "./config/preset/preact": {
            "types": "./dist/config/preset/preact.d.ts",
            "default": "./dist/config/preset/preact.js"
        },
        "./config/preset/solid": {
            "types": "./dist/config/preset/solid.d.ts",
            "default": "./dist/config/preset/solid.js"
        },
        "./config/preset/svelte": {
            "types": "./dist/config/preset/svelte.d.ts",
            "default": "./dist/config/preset/svelte.js"
        },
        "./config/preset/vue": {
            "types": "./dist/config/preset/vue.d.ts",
            "default": "./dist/config/preset/vue.js"
        },
        "./css/loader/sourcemap": {
            "types": "./dist/rollup/plugins/css/loaders/sourcemap.d.ts",
            "default": "./dist/rollup/plugins/css/loaders/sourcemap.js"
        },
        "./css/loader/less": {
            "types": "./dist/rollup/plugins/css/loaders/less.d.ts",
            "default": "./dist/rollup/plugins/css/loaders/less.js"
        },
        "./css/loader/postcss": {
            "types": "./dist/rollup/plugins/css/loaders/postcss.d.ts",
            "default": "./dist/rollup/plugins/css/loaders/postcss.js"
        },
        "./css/loader/sass": {
            "types": "./dist/rollup/plugins/css/loaders/sass.d.ts",
            "default": "./dist/rollup/plugins/css/loaders/sass.js"
        },
        "./css/loader/stylus": {
            "types": "./dist/rollup/plugins/css/loaders/stylus.d.ts",
            "default": "./dist/rollup/plugins/css/loaders/stylus.js"
        },
        "./css/loader/lightningcss": {
            "types": "./dist/rollup/plugins/css/loaders/lightningcss.d.ts",
            "default": "./dist/rollup/plugins/css/loaders/lightningcss.js"
        },
        "./css/loader/tailwindcss": {
            "types": "./dist/rollup/plugins/css/loaders/tailwindcss.d.ts",
            "default": "./dist/rollup/plugins/css/loaders/tailwindcss.js"
        },
        "./css/minifier/cssnano": {
            "types": "./dist/rollup/plugins/css/minifiers/cssnano.d.ts",
            "default": "./dist/rollup/plugins/css/minifiers/cssnano.js"
        },
        "./css/minifier/lightningcss": {
            "types": "./dist/rollup/plugins/css/minifiers/lightningcss.d.ts",
            "default": "./dist/rollup/plugins/css/minifiers/lightningcss.js"
        },
        "./transformer/esbuild": {
            "types": "./dist/rollup/plugins/esbuild/index.d.ts",
            "default": "./dist/rollup/plugins/esbuild/index.js"
        },
        "./transformer/swc": {
            "types": "./dist/rollup/plugins/swc/swc-plugin.d.ts",
            "default": "./dist/rollup/plugins/swc/swc-plugin.js"
        },
        "./transformer/sucrase": {
            "types": "./dist/rollup/plugins/sucrase/index.d.ts",
            "default": "./dist/rollup/plugins/sucrase/index.js"
        },
        "./transformer/oxc": {
            "types": "./dist/rollup/plugins/oxc/oxc-transformer.d.ts",
            "default": "./dist/rollup/plugins/oxc/oxc-transformer.js"
        },
        "./builder/typedoc": {
            "types": "./dist/builder/typedoc/index.d.ts",
            "default": "./dist/builder/typedoc/index.js"
        },
        "./files": {
            "types": "./files.d.ts"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "packem": "./dist/cli/index.js"
    },
    "files": [
        "dist",
        "files.d.ts",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "cross-env INTERNAL_PACKEM_BUILD=1 JITI_INTEROP_DEFAULT=1 jiti src/cli/index.ts build --development",
        "build:prod": "cross-env INTERNAL_PACKEM_BUILD=1 JITI_INTEROP_DEFAULT=1 jiti src/cli/index.ts build --production",
        "clean": "rimraf node_modules dist .eslintcache",
        "dev": "pnpm run build",
        "lint:attw": "attw --pack",
        "lint:eslint": "eslint ./src",
        "lint:eslint:fix": "eslint . --cache --concurrency auto --fix,",
        "lint:package-json": "publint --strict",
        "lint:prettier": "prettier --config=.prettierrc.cjs --check .",
        "lint:prettier:fix": "prettier --config=.prettierrc.cjs --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run --cache",
        "test:coverage": "vitest run --cache --coverage",
        "test:ui": "vitest --cache --ui --coverage.enabled=true",
        "test:watch": "vitest"
    },

".subfoo {
    background-image: url("./assets/bg.png");
    background-image: url("./assets/bg.testing.regex.png");
    background-image: url("./nonexistant");
}

.foo {
    background-image: url("./assets/bg.png"), url("./assets/bg1.testing.regex.png"), url("./assets/bg1.testing.regex.png");
}

.foo2 {
    background-image: -webkit-image-set("./assets/cat.png" 1x, url("./assets/cat-2x.png") 2x, url(./assets/cat-print.png) 600dpi);
    background-image: image-set("./assets/cat.png" 1x);
}

.foo3 {
    background-image: url("./assets/bg.png?query=#hash");
}

@import url("https://fonts.googleapis.com/css?family=Gudea:400,700");

.bar {
  background-image: url("./assets/bg1.png");
}

.bar2 {
  color: magenta;
  background-image: url("https://via.placeholder.com/1920x1080");
}

@font-face {
  font-family: "Demo";
  font-style: normal;
  font-weight: 400;
  src: local("Demo"), local("Demo-Regular"), url("./assets/Demo-webfont.woff") format("woff");
}

.bg {
  background-image: url(./assets/bg1.png);
}

.ignore-data-uri {
  background-image: url("data:image/png;base64,");
}"
`;


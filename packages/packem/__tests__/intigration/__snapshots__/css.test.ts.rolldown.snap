		secondary: "bg-gray-600 hover:bg-gray-700 text-white",
		outline: "border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white"
	}[variant]} \${{
		small: "px-3 py-1.5 text-sm",
		medium: "px-4 py-2 text-base",
		large: "px-6 py-3 text-lg"
	}[size]}\`;
	return React.createElement("button", { className: classes }, children);
}
//#endregion
//#region src/components/Card.jsx
function Card({ title, children, variant = "default" }) {
	const classes = \`card rounded-xl shadow-lg \${{
		default: "bg-white border border-gray-200",
		elevated: "bg-white shadow-2xl transform hover:scale-105",
		outlined: "bg-transparent border-2 border-gray-300"
	}[variant]}\`;

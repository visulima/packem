{
    "name": "@visulima/packem-rollup",
    "version": "1.0.0-alpha.82",
    "description": "Rollup plugins for packem",
    "keywords": [
        "visulima",
        "packem-rollup"
    ],
    "homepage": "https://github.com/visulima/packem/tree/main/packages/packem-rollup",
    "bugs": {
        "url": "https://github.com/visulima/packem/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/visulima/packem.git",
        "directory": "packages/packem-rollup"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/prisis"
        },
        {
            "type": "consulting",
            "url": "https://anolilab.com/support"
        }
    ],
    "license": "MIT",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./esbuild": {
            "types": "./dist/plugins/esbuild/index.d.ts",
            "default": "./dist/plugins/esbuild/index.js"
        },
        "./swc": {
            "types": "./dist/plugins/swc/index.d.ts",
            "default": "./dist/plugins/swc/index.js"
        },
        "./sucrase": {
            "types": "./dist/plugins/sucrase/index.d.ts",
            "default": "./dist/plugins/sucrase/index.js"
        },
        "./plugin/chunk-splitter": {
            "types": "./dist/plugins/chunk-splitter/index.d.ts",
            "default": "./dist/plugins/chunk-splitter/index.js"
        },
        "./plugin/cjs-interop": {
            "types": "./dist/plugins/cjs-interop.d.ts",
            "default": "./dist/plugins/cjs-interop.js"
        },
        "./plugin/json": {
            "types": "./dist/plugins/json.d.ts",
            "default": "./dist/plugins/json.js"
        },
        "./plugin/jsx-remove-attributes": {
            "types": "./dist/plugins/jsx-remove-attributes.d.ts",
            "default": "./dist/plugins/jsx-remove-attributes.js"
        },
        "./plugin/preserve-directives": {
            "types": "./dist/plugins/preserve-directives.d.ts",
            "default": "./dist/plugins/preserve-directives.js"
        },
        "./plugin/pure-new-expression": {
            "types": "./dist/plugins/pure-new-expression-plugin.d.ts",
            "default": "./dist/plugins/pure-new-expression-plugin.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "CHANGELOG.md",
        "README.md",
        "dist"
    ],
    "scripts": {
        "build": "../../node_modules/.bin/packem build --development",
        "build:prod": "../../node_modules/.bin/packem build --production",
        "clean": "rimraf node_modules dist .eslintcache",
        "dev": "pnpm run build --watch",
        "lint:attw": "attw --pack --profile esm-only",
        "lint:eslint": "eslint . --cache --concurrency auto",
        "lint:eslint:fix": "eslint . --cache --concurrency auto --fix,",
        "lint:package-json": "publint --strict",
        "lint:prettier": "prettier --config=.prettierrc.cjs --check .",
        "lint:prettier:fix": "prettier --config=.prettierrc.cjs --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:bench": "vitest bench --run",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui --coverage.enabled=true",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@babel/core": "catalog:dev",
        "@rollup/plugin-alias": "catalog:build",
        "@rollup/plugin-commonjs": "catalog:build",
        "@rollup/plugin-dynamic-import-vars": "catalog:build",
        "@rollup/plugin-inject": "catalog:build",
        "@rollup/plugin-json": "catalog:build",
        "@rollup/plugin-replace": "catalog:build",
        "@rollup/plugin-wasm": "catalog:build",
        "@rollup/pluginutils": "catalog:build",
        "@swc/types": "catalog:dev",
        "@visulima/find-cache-dir": "catalog:visulima",
        "@visulima/fs": "catalog:visulima",
        "@visulima/package": "catalog:visulima",
        "@visulima/packem-share": "1.0.0-alpha.57",
        "@visulima/path": "catalog:visulima",
        "@visulima/rollup-plugin-dts": "1.0.0-alpha.42",
        "clean-css": "catalog:style",
        "html-minifier-next": "catalog:prod",
        "magic-string": "catalog:utils",
        "oxc-resolver": "catalog:node",
        "oxc-transform": "catalog:dev",
        "rollup-plugin-import-trace": "catalog:build",
        "rollup-plugin-polyfill-node": "catalog:build",
        "rollup-plugin-pure": "catalog:build",
        "rollup-plugin-visualizer": "catalog:build",
        "rs-module-lexer": "catalog:prod"
    },
    "devDependencies": {
        "@anolilab/eslint-config": "catalog:lint",
        "@anolilab/prettier-config": "catalog:lint",
        "@anolilab/semantic-release-pnpm": "catalog:cli",
        "@anolilab/semantic-release-preset": "catalog:cli",
        "@arethetypeswrong/cli": "catalog:dev",
        "@oxc-parser/binding-linux-x64-gnu": "catalog:dev",
        "@oxc-project/types": "catalog:dev",
        "@secretlint/secretlint-rule-preset-recommend": "catalog:lint",
        "@swc/core": "catalog:dev",
        "@total-typescript/ts-reset": "catalog:tsc",
        "@types/babel__core": "catalog:types",
        "@types/clean-css": "catalog:types",
        "@types/estree": "catalog:types",
        "@types/html-minifier-next": "catalog:types",
        "@types/node": "catalog:types",
        "@types/semver": "catalog:types",
        "@visulima/packem-plugins": "workspace:*",
        "@visulima/pail": "catalog:visulima",
        "@visulima/tsconfig": "catalog:visulima",
        "@vitest/coverage-v8": "catalog:test",
        "@vitest/ui": "catalog:test",
        "browserslist": "catalog:network",
        "conventional-changelog-conventionalcommits": "catalog:dev",
        "esbuild": "catalog:build",
        "eslint": "catalog:lint",
        "estree-walker": "catalog:dev",
        "hookable": "catalog:dev",
        "jiti": "catalog:script",
        "mime": "catalog:dev",
        "p-queue": "catalog:dev",
        "prettier": "catalog:lint",
        "publint": "catalog:lint",
        "rimraf": "catalog:node",
        "rollup": "catalog:build",
        "secretlint": "catalog:lint",
        "semantic-release": "catalog:cli",
        "sucrase": "catalog:dev",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@swc/core": "*",
        "esbuild": "*",
        "rollup": ">=4.61.0",
        "sucrase": "*"
    },
    "peerDependenciesMeta": {
        "@swc/core": {
            "optional": true
        },
        "esbuild": {
            "optional": true
        },
        "sucrase": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.22.2 || >= 24.10.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}

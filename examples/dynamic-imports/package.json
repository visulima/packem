{
    "name": "examples_packem_dynamic-imports",
    "version": "1.0.0",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "files": [
        "./dist"
    ],
    "scripts": {
        "build": "packem build",
        "clean": "rimraf node_modules dist"
    },
    "devDependencies": {
        "@visulima/packem": "workspace:*",
        "esbuild": "catalog:build",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=20"
    }
}

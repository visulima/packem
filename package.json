{
    "name": "visulima",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "scripts": {
        "audit": "audit-ci --config ./audit-ci.jsonc",
        "build": "vis run build --query \"project!=advanced-tailwind-test\"",
        "build:affected:packages": "vis affected build --fail-fast --query \"tag=type:package\"",
        "build:affected:prod:packages": "vis affected build:prod --fail-fast --query \"tag=type:package\"",
        "build:packages": "vis run build --query \"tag=type:package\"",
        "build:prod:packages": "vis run build:prod --query \"tag=type:package\"",
        "clean": "vis run clean && rimraf ./node_modules",
        "graph": "vis graph",
        "lint": "pnpm run lint:prettier && pnpm run lint:eslint",
        "lint:affected:attw": "vis affected lint:attw --fail-fast --query \"tag=type:package\"",
        "lint:affected:eslint": "vis affected lint:eslint --fail-fast --query \"tag=type:package\"",
        "lint:affected:eslint:fix": "vis affected lint:eslint:fix --fail-fast --query \"tag=type:package\"",
        "lint:affected:package-json": "vis affected lint:package-json --fail-fast --query \"tag=type:package\"",
        "lint:affected:types": "vis affected lint:types --fail-fast --query \"tag=type:package\"",
        "lint:attw": "vis run lint:attw",
        "lint:eslint": "vis run lint:eslint",
        "lint:eslint:fix": "vis run lint:eslint:fix",
        "lint:fix": "pnpm run lint:prettier:fix && pnpm run lint:eslint:fix && pnpm run sort-package-json",
        "lint:package-json": "vis run lint:package-json --query \"tag=type:package\"",
        "lint:prettier": "pnpm run lint:prettier:root && vis run lint:prettier",
        "lint:prettier:fix": "pnpm run lint:prettier:root:fix && vis run lint:prettier:fix",
        "lint:prettier:root": "prettier --config=.prettierrc.cjs --check '*.{json,yml,yaml,js,mjs,cjs,ts}' && prettier --config=.prettierrc.cjs --check 'examples/**/*.{json,yml,yaml,js,mjs,cjs,ts}' && prettier --config=.prettierrc.cjs --check 'scripts/**/*.{json,yml,yaml,js,mjs,cjs,ts}'",
        "lint:prettier:root:fix": "prettier --config=.prettierrc.cjs --write '*.{json,yml,yaml,js,mjs,cjs,ts}' && prettier --config=.prettierrc.cjs --write 'examples/**/*.{json,yml,yaml,js,mjs,cjs,ts}' && prettier --config=.prettierrc.cjs --write 'scripts/**/*.{json,yml,yaml,js,mjs,cjs,ts}'",
        "lint:secrets": "secretlint **/*",
        "lint:staged": "lint-staged --verbose --concurrent false --debug",
        "lint:text": "textlint ./.github/ ./packages/** ./README.md ./UPGRADE.md --experimental --cache --dry-run",
        "lint:text:fix": "textlint ./.github/ ./packages/** ./README.md ./UPGRADE.md --parallel --experimental --fix",
        "lint:types": "vis run lint:types",
        "plop": "plop",
        "prepare": "is-ci || husky || exit 0",
        "sort-package-json": "sort-package-json packages/**/package.json examples/**/package.json benchmarks/package.json ./package.json",
        "test": "vis run test --no-color --query \"tag=type:package\"",
        "test:affected": "vis affected test --no-color --fail-fast --query \"tag=type:package\"",
        "test:affected:bench": "vis affected test:bench --fail-fast --query \"tag=type:package\"",
        "test:affected:coverage": "vis affected test:coverage --no-color --fail-fast --query \"tag=type:package\"",
        "test:bench": "vis run test:bench",
        "test:coverage": "vis run test:coverage --no-color --fail-fast --query \"tag=type:package\""
    },
    "browserslist": [
        "extends browserslist-config-anolilab"
    ],
    "dependencies": {
        "@anolilab/commitlint-config": "catalog:lint",
        "@anolilab/lint-staged-config": "catalog:lint",
        "@anolilab/multi-semantic-release": "catalog:cli",
        "@anolilab/prettier-config": "catalog:lint",
        "@anolilab/textlint-config": "catalog:lint",
        "@codspeed/vitest-plugin": "catalog:test",
        "@commitlint/cli": "catalog:lint",
        "@commitlint/config-conventional": "catalog:lint",
        "@secretlint/secretlint-rule-preset-recommend": "catalog:lint",
        "@visulima/packem": "catalog:visulima",
        "@visulima/vis": "catalog:monorepo",
        "audit-ci": "catalog:prod",
        "browserslist-config-anolilab": "catalog:network",
        "commitizen": "catalog:cli",
        "cross-env": "catalog:node",
        "esbuild": "catalog:build",
        "husky": "catalog:lint",
        "is-ci": "catalog:prod",
        "lint-staged": "catalog:lint",
        "oxc-parser": "catalog:prod",
        "pkg-pr-new": "catalog:node",
        "plop": "catalog:prod",
        "prettier": "catalog:lint",
        "publint": "catalog:lint",
        "rimraf": "catalog:node",
        "secretlint": "catalog:lint",
        "semantic-release": "catalog:cli",
        "sort-package-json": "catalog:prod",
        "textlint": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "packageManager": "pnpm@11.28.8",
    "engines": {
        "node": "^22.22.2 || >= 24.10.0"
    }
}
